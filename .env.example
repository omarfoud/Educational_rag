HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

DATABASE_URL=sqlite:///./data/app.db
VECTOR_DB_PATH=./data/chroma_db
UPLOAD_PATH=./data/uploads
TEMP_PATH=./data/temp
TRANSCRIPT_PATH=./data/transcripts
VOCABULARY_SCAN_PATH=./data/vocabulary-scans
VOCABULARY_SCAN_PROVIDER=gemini
VOCABULARY_SCAN_MODEL=gpt-4.1
VOCABULARY_GEMINI_MODEL=gemini-2.5-flash
VOCABULARY_TTS_PROVIDER=openai
VOCABULARY_TTS_VOICE=cedar
VOCABULARY_TTS_ITEM_PAUSE_SECONDS=1.0

GOOGLE_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
OPENAI_TTS_SPEED=0.9
LLM_PROVIDER=openai
ALLOW_GEMINI_FALLBACK=false
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-5.4-nano
QUESTION_REVIEW_MODEL=gpt-5.4-mini
QUESTION_REVIEW_TIMEOUT_SECONDS=180

EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32

ENABLE_AUDIO_PROCESSING=true
ENABLE_OCR_PROCESSING=true
KEEP_UPLOADED_FILES=true
SAVE_TRANSCRIPT_FILES=true
SAVE_CHUNKS_TO_POSTGRES=true

TRANSCRIPTION_PROVIDER=local
OPENAI_TRANSCRIPTION_MODEL=whisper-1
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

OCR_PROVIDER=local
OPENAI_OCR_MODEL=gpt-4.1-mini
OPENAI_OCR_PAGE_BATCH_SIZE=10
GEMINI_OCR_MODEL=gemini-2.5-flash
TESSERACT_PATH=
OCR_LANGUAGES=ara+eng

# Lahgtna is an optional local GPU model. The model repository requires a
# Hugging Face read token; its bundled reference voice is used by default.
LAHGTNA_MODEL_ID=ehabnegm/lahgtna-omnivoice-egyptian-v3
LAHGTNA_MODEL_PATH=./data/models/lahgtna-omnivoice-egyptian-v3
LAHGTNA_REFERENCE_AUDIO=
LAHGTNA_REFERENCE_TEXT=كان العمل التطوعي واللي لما تفتح الباب بس ليه الناس
LAHGTNA_DEVICE=auto
LAHGTNA_NUM_STEPS=8
LAHGTNA_ALLOW_DOWNLOAD=false
LAHGTNA_FALLBACK_TO_OPENAI=true

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_FILE_SIZE=500
DEFAULT_LANGUAGE=ar
FALLBACK_LANGUAGE=en
SUPPORTED_LANGUAGES=ar,en,fr,es

# Bunny CDN Config
BUNNY_ACCESS_KEY=
BUNNY_CDN_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_CDN_TOKEN_EXPIRATION_SECONDS=21600

